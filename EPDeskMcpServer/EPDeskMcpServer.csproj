<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Referenced for the EF model, AppDbContext, and the Backblaze client, so
      this service never re-declares the schema it reads. EPDeskServerApi still
      owns migrations; this project only reads.
    -->
    <ProjectReference Include="..\EPDeskServerApi\EPDeskServerApi.csproj" />
  </ItemGroup>

  <!--
    The Web SDK flows a referenced web project's appsettings*.json into this
    project's output, which collides with our own file and fails publish
    outright. Drop the inherited copies so this service is configured only by
    its own appsettings.json and by environment variables.
  -->
  <Target Name="DropInheritedAppSettingsFromBuild"
          AfterTargets="_GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <AllItemsFullPathWithTargetPath
        Remove="@(AllItemsFullPathWithTargetPath)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('appsettings')) AND
                   !$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)'))" />
    </ItemGroup>
  </Target>

  <Target Name="DropInheritedAppSettingsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('appsettings')) AND
                   !$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)'))" />
    </ItemGroup>
  </Target>

</Project>
