{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "ExtractionWorker": {
    "ProcessingEnabled": false,
    "PipelineVersion": "v1",
    "PollIntervalSeconds": 5,
    "MaxConcurrentJobs": 1,
    "LeaseSeconds": 300,
    "HeartbeatSeconds": 60,
    "ProcessingTimeoutSeconds": 600,
    "RetryBaseSeconds": 30,
    "MaxDownloadBytes": 268435456,
    "MaxJobsPerInstanceLifetime": 1,
    "CanaryJobId": "",
    "RequireTrustedSourceIdentity": true,
    "AllowedExtensions": [".pdf", ".docx", ".pptx", ".txt", ".md"],
    "SandboxBaseUrl": "",
    "SandboxApiKey": "",
    "MaxSandboxResponseBytes": 134217728,
    "TempRoot": "/tmp/epdesk-extraction",
    "OcrImagesEnabled": false,
    "IncludeSpeakerNotes": false
  }
}
