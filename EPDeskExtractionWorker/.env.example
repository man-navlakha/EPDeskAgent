ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=epdesk;Username=epdesk;Password=replace-me
B2__ServiceUrl=https://s3.your-region.backblazeb2.com
B2__Region=your-region
B2__BucketName=your-private-bucket
B2__KeyId=replace-me
B2__ApplicationKey=replace-me
B2__ConnectionTestPrefix=uploads/
ExtractionWorker__PollIntervalSeconds=5
ExtractionWorker__MaxConcurrentJobs=1
ExtractionWorker__ProcessingEnabled=false
ExtractionWorker__PipelineVersion=v1
ExtractionWorker__LeaseSeconds=300
ExtractionWorker__HeartbeatSeconds=60
ExtractionWorker__ProcessingTimeoutSeconds=600
ExtractionWorker__RetryBaseSeconds=30
ExtractionWorker__MaxDownloadBytes=268435456
ExtractionWorker__MaxJobsPerInstanceLifetime=1
ExtractionWorker__CanaryJobId=
ExtractionWorker__RequireTrustedSourceIdentity=true
ExtractionWorker__AllowedExtensions__0=.pdf
ExtractionWorker__AllowedExtensions__1=.docx
ExtractionWorker__AllowedExtensions__2=.pptx
ExtractionWorker__AllowedExtensions__3=.txt
ExtractionWorker__AllowedExtensions__4=.md
ExtractionWorker__SandboxBaseUrl=http://epdesk-extraction-sandbox.railway.internal:8080
ExtractionWorker__SandboxApiKey=replace-with-a-long-random-secret
ExtractionWorker__MaxSandboxResponseBytes=134217728
ExtractionWorker__TempRoot=/tmp/epdesk-extraction
ExtractionWorker__OcrImagesEnabled=false
ExtractionWorker__IncludeSpeakerNotes=false
PORT=8080
